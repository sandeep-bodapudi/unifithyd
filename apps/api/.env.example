# Copy to .env and fill in. Never commit .env.
DATABASE_URL="mysql://unifit:change-me@localhost:3306/unifit"
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API in production
APP_ORIGIN="http://localhost:5173"
APP_SECRET="replace-with-a-long-random-string-of-32-plus-chars"
# QR_PRIVATE_KEY=   (base64 of an Ed25519 PKCS8 PEM; generated automatically in development)
# RESEND_API_KEY=
# MAIL_FROM="Unifit.hyd <no-reply@unifithyd.com>"
DEV_SHOW_CODES=false
JOBS_ENABLED=true
