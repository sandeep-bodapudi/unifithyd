{
  "name": "unifit",
  "private": true,
  "version": "0.1.0",
  "description": "Unifit.hyd: public website, member PWA and staff dashboard (see docs/Unifit_hyd_PRD_v3.0.md)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @unifit/web",
    "dev:api": "npm run dev -w @unifit/api",
    "build": "npm run build -w @unifit/web && npm run build -w @unifit/api",
    "logo": "node brand/tools/gen-logo.mjs brand/logo",
    "db:local": "\"C:/Program Files/MariaDB 12.3/bin/mariadbd.exe\" --defaults-file=.data/mariadb/my.ini --console",
    "test": "npm test -w @unifit/api"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5"
  }
}
